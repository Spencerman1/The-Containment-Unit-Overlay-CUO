              <p>Tracking user actions, screen data, metadata, and active applications.</p>
              <div className="mt-4">
                <Switch checked={trackingEnabled} onCheckedChange={setTrackingEnabled} /> Enable Forensic Tracking
              </div>
              <div className="mt-4">
                <Switch checked={autoVaulting} onCheckedChange={setAutoVaulting} /> Auto Vault Every 5 Min
