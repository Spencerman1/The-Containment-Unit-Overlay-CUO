                <li>🔍 Anomaly Detected: Clipboard access by system utility</li>
                <li>📸 Screenshot Vaulted: 11:58 AM</li>
                <li>🧩 SHA256 Match: Verified artifact integrity</li>
              </ul>
            </CardContent>
          </Card>
        </TabsContent>
      </Tabs>

      <div className="fixed bottom-4 right-4 flex gap-2">
        <Button onClick={() => setExpanded(!isExpanded)}>
          {isExpanded ? '🗕 Collapse Shield' : '🗖 Expand Full Screen'}
        </Button>
        <Button variant="destructive">❌ Exit Shield</Button>
      </div>
    </div>
  );
}


